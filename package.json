{
  "name": "web-automation-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic browser automation MCP with ChatGPT Web as the first provider.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "login": "npm run build --silent && node dist/cli/login-main.js",
    "session:status": "npm run build --silent && node dist/cli/session-status-main.js",
    "diagnose:history": "npm run build --silent && node dist/cli/history-diagnostic-main.js",
    "verify:persistence": "npm run build --silent && node dist/cli/verify-persistence-main.js",
    "validate:live": "npm run build --silent && node dist/cli/live-validation-main.js",
    "validate:completion": "npm run build --silent && node dist/cli/completion-validation-main.js",
    "validate:conversations": "npm run build --silent && node dist/cli/conversation-validation-main.js",
    "validate:cleanup": "npm run build --silent && node dist/cli/conversation-cleanup-validation-main.js",
    "mcp:smoke": "node scripts/mcp-inspector-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "playwright": "1.62.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
